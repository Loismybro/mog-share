{
  "name": "shareapp",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"signaling,web\" -c \"magenta,yellow\" \"npm run dev:signaling\" \"npm run dev:web\"",
    "dev:signaling": "npx tsx apps/signaling/src/index.ts",
    "dev:web": "npx vite apps/web",
    "build": "npx vite build --config apps/web/vite.config.ts apps/web && node -e \"const fs=require('fs'); fs.cpSync('apps/web/dist', 'dist', {recursive: true}); fs.copyFileSync('apps/web/dist/index.html', 'dist/404.html');\"",
    "build:web": "npx vite build --config apps/web/vite.config.ts apps/web",
    "build:signaling": "npx tsc --project apps/signaling/tsconfig.json",
    "vercel-build": "npm run build",
    "start": "npx tsx apps/signaling/src/index.ts",
    "test": "npx vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "2.1.9"
  }
}
