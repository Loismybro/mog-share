{
  "name": "shareapp",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"signaling,web\" -c \"magenta,yellow\" \"npm run dev:signaling\" \"npm run dev:web\"",
    "dev:signaling": "npx tsx apps/signaling/src/index.ts",
    "dev:web": "npx vite apps/web",
    "dev:client": "npm run dev --prefix packages/client",
    "dev:server": "npm run dev --prefix packages/server",
    "build": "npx vite build --config apps/web/vite.config.ts apps/web && node -e \"const fs=require('fs'); fs.cpSync('apps/web/dist', 'dist', {recursive: true});\"",
    "build:web": "npx vite build --config apps/web/vite.config.ts apps/web",
    "build:signaling": "npx tsc --project apps/signaling/tsconfig.json",
    "build:client": "npm run build --prefix packages/client",
    "vercel-build": "npm run build",
    "start": "npx tsx apps/signaling/src/index.ts",
    "test": "npx vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
