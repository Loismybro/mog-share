{
  "name": "mog-share",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"magenta,yellow\" \"npm run dev --prefix packages/server\" \"npm run dev --prefix packages/client\"",
    "dev:client": "npm run dev --prefix packages/client",
    "dev:server": "npm run dev --prefix packages/server",
    "build": "npm run build --prefix packages/client && node -e \"const fs=require('fs'); fs.cpSync('packages/client/dist', 'dist', {recursive: true});\"",
    "build:client": "npm run build --prefix packages/client",
    "vercel-build": "npm run build",
    "start": "npm start --prefix packages/server",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "concurrently": "^10.0.5",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.13",
    "@types/ws": "^8.18.2",
    "vitest": "^5.0.3"
  }
}
